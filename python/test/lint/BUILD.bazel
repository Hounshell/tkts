load("@rules_python//python:py_test.bzl", "py_test")
load("@pip//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "lint",
    srcs = [":run_pylint.py"],
    main = "run_pylint.py",
    args = [
        "$(locations //python/src:src_files)",
        "--rcfile=$(location :.pylintrc)",
    ],
    data = [
        "//python/src:src_files",
        ":.pylintrc",
    ],
    deps = [
        requirement("pylint"),
        requirement("astroid"),
        requirement("dill"),
        requirement("isort"),
        requirement("mccabe"),
        requirement("platformdirs"),
        requirement("tomlkit"),
        requirement("typing-extensions"),
    ],
)

