load("@rules_java//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "src_files",
    srcs = glob(["**/*.java"]),
)

java_library(
    name = "src",
    srcs = [":src_files"],
)

java_binary(
    name = "app",
    main_class = "com.example.App",
    runtime_deps = [":src"],
)

